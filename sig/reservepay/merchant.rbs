      def update_key_person: (key_person_id: String, first_name: String, ?middle_name: String, last_name: String, ?first_name_local_language: String, ?middle_name_local_language: String, ?last_name_local_language: String, date_of_birth: String, nationality: String, type: "UBO" | "AUTHORIZED_SIGNATORY", ?percentage_of_ownership: Integer | Float, ?authorized_director: bool, ?national_id: String, ?national_id_expiry_date: String, ?national_id_without_expiry_date: bool, ?passport_number: String, ?passport_expiry_date: String, ?address_street_1: String, ?address_street_2: String, ?postal_code: String, ?city: String, ?primary_administrative_division: String, ?country: String, ?current_address_street_1: String, ?current_address_street_2: String, ?current_address_postal_code: String, ?current_address_city: String, ?current_address_primary_administrative_division: String, ?current_address_country: String, ?use_residence_registration_as_current_address: bool) -> bool
      def update_merchant_settings: (?preferred_communication_language: "en" | "th", ?payout_contact_authorization_required: bool, ?payout_allow_self_authorization: bool, ?payout_skip_authorization_for_api_key: bool) -> bool
      def update_sales_channel: (sales_channel_id: String, ?url: String, ?demo_url: String, ?instructions: String) -> bool
      def update_terminal: (terminal_id: String, ?name: String, ?external_id: String, ?installation_id: String, ?branch_name: String, ?kiosk_mode: bool, ?delegated_terminal_id: String) -> String
      def validate_bank_account: (bank_code: String, account_number: String, ?name: String, ?local_name: String, sensitivity: Integer | Float) -> ValidateBankAccountResult
      def void_payment: (payment_id: String) -> bool

      def call: (String endpoint_name, ?Hash[Symbol, untyped] args) -> untyped
      def package: () -> untyped
      def bearer_auth=: (String?) -> void
      def version=: (String?) -> void
      def pipeline=: (untyped) -> void
    end
  end
end
